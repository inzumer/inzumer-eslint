{
  "name": "@inzumer/eslint",
  "version": "1.0.0",
  "description": "Shared ESLint flat configuration for Inzumer projects (TypeScript, React, a11y, Vitest)",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/inzumer-eslint#readme",
  "bugs": {
    "url": "https://github.com/inzumer/inzumer-eslint/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/inzumer-eslint.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./react": "./react.js",
    "./testing": "./testing.js"
  },
  "files": [
    "*.js",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4"
  },
  "scripts": {
    "check": "node -e \"import('./index.js').then((m) => { if (!m.base || !m.react || !m.testing) process.exit(1) })\" && prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  }
}
